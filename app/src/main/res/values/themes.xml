<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme Material Design 3 -->
    <style name="Base.Theme.GPSCamiones" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Primarios Corporativos -->
        <item name="colorPrimary">@color/primary_petrol</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary_accent</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>

        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorSurfaceVariant">@color/bg_surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="android:statusBarColor">@color/primary_petrol_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.GPSCamiones" parent="Base.Theme.GPSCamiones" />

    <!-- Estilos de Tarjetas Material 3 Corporativas -->
    <style name="Widget.GPSCamiones.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/bg_card_stroke</item>
    </style>

    <style name="Widget.GPSCamiones.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/bg_card_stroke</item>
    </style>

    <!-- Botones Corporativos -->
    <style name="Widget.GPSCamiones.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_petrol</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.GPSCamiones.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/status_danger</item>
        <item name="android:textColor">@color/status_danger</item>
        <item name="iconTint">@color/status_danger</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.GPSCamiones.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/primary_petrol</item>
        <item name="iconTint">@color/primary_petrol</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
